# ==============================================================================
# Quveta — AI Event Planning Platform Environment Configuration
# Copy this file to .env.local or .env to configure your local environment.
# ==============================================================================

# 1. Google Gemini AI API Configuration
# Optional: If omitted or empty, Quveta automatically uses its deterministic
# rule-based planning & decision fallback generator without breaking.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
NEXT_PUBLIC_ENABLE_AI_FEATURES="true"

# 2. Application Identity & Host
NEXT_PUBLIC_APP_NAME="Quveta"
NEXT_PUBLIC_APP_DESCRIPTION="AI Event Planning & Adaptive Budget Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 3. Regional & Financial Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"

# 4. Storage & Relational Database Configuration
# Defaults to the verified local file-based database with integer minor unit math.
DATABASE_STORAGE_PATH="./data/quveta.db.json"

# 5. Optional Supabase Integration
# If specified, the repository layer connects directly to Supabase cloud storage.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
